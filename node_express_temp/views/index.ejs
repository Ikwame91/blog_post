<!DOCTYPE html>
<html lang="en">
  <%- include('layouts/header');-%>

  <body>
    <!-- Navigation -->
    <%- include('layouts/navbar');-%>

    <!-- Page Header -->
    <header class="masthead" style="background-image: url('img/home-bg.jpg')">
      <div class="overlay"></div>
      <div class="container">
        <div class="row">
          <div class="col-lg-8 col-md-10 mx-auto">
            <div class="site-heading">
              <h1>Kwames Blog</h1>
              <span class="subheading">A Blog site from Kwame Agyapong</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <form action="/" method="GET">
      <input type="text" name="search" placeholder="search for blog posts" />
      <button type="submit">search</button>
    </form>

    <div class="container">
      <div class="row">
        <div class="col-lg-8 col-md-10 mx-auto">
          <% for (var i = 0; i < blogposts.length; i++){ %>
          <div class="post-preview">
            <a href="/post/<%= blogposts[i]._id%>">
              <h2 class="post-title"><%= blogposts[i].title %></h2>
              <h3 class="post-subtitle"><%- blogposts[i].body %></h3>
            </a>
            <p class="post-meta">
              <Posted by></Posted>
              <a href="#"><%= blogposts[i].userid.username %></a>
              on <%= blogposts[i].datePosted.toDateString() %>
            </p>
          </div>
          <hr />
          <%}%>
          <!-- Pager -->
          <div class="clearfix">
            <a class="btn btn-primary float-right" href="#"
              >Older Posts &rarr;</a
            >
          </div>
        </div>
      </div>
    </div>

    <hr />

    <%- include('layouts/footer');-%> <%- include('layouts/scripts');-%>
  </body>
</html>


<!-- Use <%#= %> when displaying user-generated content like usernames or comments to prevent security risks (XSS attacks).
Use <%#- %> only when you trust the content and want to render raw HTML (e.g., formatted blog post content).
<%#= blogposts[i].userid.username %></a>
Safer (prevents XSS if username contains <script> or other harmful code).
  <%#- blogposts[i].userid.username %></a>
  Not safe (renders raw HTML if username contains HTML tags or scripts).

  For usernames, stick to <%#= %> to avoid security risks! 🚀 -->